# Copia este archivo a `.env` EN EL DROPLET (NO lo commitees). Lo leen el deploy y pm2.
PORT=3108                 # Puerto local de esta app. SvelteKit usa 300x (3000, 3100, 3200...)
HOST=127.0.0.1                # Siempre localhost; nginx hace el proxy reverso
ORIGIN=https://xochimilco.moibe.me     # Requerido por SvelteKit para aceptar POST/form-actions en prod
# DATABASE_URL=./local.db     # Descomenta si usas SQLite (better-sqlite3 + drizzle)
# ADMIN_PASSWORD=             # Si tu app tiene panel admin
